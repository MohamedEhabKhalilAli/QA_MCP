# ─────────────────────────────────────────────────────────────
# QA MCP configuration — copy to .env and fill in what you use.
# (Values can also be set in the "env" block of your MCP client config.)
# ─────────────────────────────────────────────────────────────

# Where per-story artifacts + generated projects are stored (relative to this folder or absolute)
QA_WORKSPACE_DIR=workspace
# jira | azure — used when the tracker can't be inferred from the story id
DEFAULT_TRACKER=jira
# Default application URL for generated projects (optional)
APP_BASE_URL=

# ── Jira ──────────────────────────────────────────────────────
JIRA_BASE_URL=https://paysky1.atlassian.net
JIRA_EMAIL=mohamed.ehab@paysky.io
# Cloud: API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Server/DC: a Personal Access Token (set JIRA_AUTH_TYPE=bearer and JIRA_API_VERSION=2)
JIRA_API_TOKEN=
JIRA_AUTH_TYPE=basic
JIRA_API_VERSION=3
# Project for new test cases (defaults to the story's project)
JIRA_PROJECT_KEY=MTN
# Issue type for test cases ("Test" with Xray/Zephyr). Falls back to JIRA_FALLBACK_ISSUE_TYPE if it doesn't exist.
JIRA_TEST_ISSUE_TYPE=Test
JIRA_FALLBACK_ISSUE_TYPE=Task
JIRA_LINK_TYPE=Relates
# Custom field holding acceptance criteria, e.g. customfield_10035 (otherwise parsed from the description)
JIRA_ACCEPTANCE_CRITERIA_FIELD=customfield_10526
JIRA_EXTRA_FIELDS={"customfield_10113":{"value":"Cobra"}}

# ── Azure DevOps ──────────────────────────────────────────────
AZDO_ORG_URL=https://devops.paysky.io/DefaultCollection/
AZDO_PROJECT=Next Team
# PAT scopes: Work Items (Read & Write), Test Management (Read & Write), Code (Read & Write)
AZDO_PAT=
AZDO_API_VERSION=7.1
# Optional: add created test cases to this plan/suite
AZDO_TEST_PLAN_ID=
AZDO_TEST_SUITE_ID=
AZDO_AREA_PATH=
AZDO_ITERATION_PATH=

# ── GitHub ────────────────────────────────────────────────────
# Fine-grained token with Contents: Read & Write (+ Administration: Read & Write to auto-create repos)
GITHUB_TOKEN=
# User or organisation that owns the repos (defaults to the token's user)
GITHUB_OWNER=MohamedEhabKhalilAli
GITHUB_API_URL=https://api.github.com

# ── Git commit identity ───────────────────────────────────────
GIT_AUTHOR_NAME=QA MCP Bot
GIT_AUTHOR_EMAIL=mohamed.ehab@paysky.io
GIT_DEFAULT_BRANCH=main
